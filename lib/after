#!/bin/sh
#
# after - A script executed after the main deferred-sync process.
#
# This script is intended for post-execution tasks, such as:
#   - Cleaning up temporary files
#   - Sending completion notifications
#   - Logging the end of the sync process
#
# Note:
#   - This file is an example of the shape an ENDSCRIPT takes, not a place to keep one.
#     install.sh redeploys lib/ on every install, so an edit made here is lost on upgrade.
#     A host that needs its own post-execution logic keeps that script outside the
#     installation target and points ENDSCRIPT in sync.conf at it.
#   - This script is sourced by the job, so it returns instead of exiting.

start_message() {
    printf -- "[INFO] Loading: endscript has been loaded at "
    date "+%Y/%m/%d %T"
}

main() {
    start_message
    # A host keeps its own post-execution logic in the file ENDSCRIPT points at,
    # not here. See the note in the header.
    return $?
}

main "$@"
