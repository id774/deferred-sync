#!/bin/sh
#
# 85_get_remote_dir - A script to sync remote directories to a local target using rsync.
#
# Required environment variables:
#   GET_TARGET_DIR  : Local target directory for remote sync.
#                     Example: /var/remotebackups
#   REMOTE_USER     : Username for remote SSH login.
#                     Example: backupuser
#   GET_HOSTS       : List of remote hosts (space-separated).
#                     Example: "server1.example.com server2.example.com"
#   GET_REMOTE_DIRS : List of remote directories to sync (space-separated).
#                     Example: "/remote/data /remote/logs"
#   DRY_RUN         : If set to "true", rsync runs in dry-run mode.
#
# Note:
#   - This script assumes that SSH authentication is configured via SSH keys.
#   - No ping or other independent network/security probe gates the transfer;
#     rsync/SSH is attempted directly and its own status is returned.
#
# Behavior:
#   - A missing local target directory returns semantic status 3.
#   - Each attempted rsync propagates its external status; remaining configured
#     host/directory combinations are still processed.

start_message() {
    printf -- "[INFO] Loading: get_remote_dir has been loaded at "
    date "+%Y/%m/%d %T"
}

get_remote() {
    GET_REMOTE_DIR_OPTS="-avz --delete -e ssh"

    [ "$DRY_RUN" = "true" ] && GET_REMOTE_DIR_OPTS="$GET_REMOTE_DIR_OPTS --dry-run"

    printf -- "[INFO] Executing: get remote dir at "
    date "+%Y/%m/%d %T"

    if [ ! -d "$GET_TARGET_DIR" ]; then
        printf -- "[WARN] Target directory %s does not exist. Skipping.\n" "$GET_TARGET_DIR" >&2
        return 3
    fi

    printf -- "[INFO] rsync %s %s@%s:%s %s/%s\n" "$GET_REMOTE_DIR_OPTS" "$REMOTE_USER" "$1" "$2" "$GET_TARGET_DIR" "$1"

    # Do not gate rsync on ping or other independent network/security probes.
    # Network policy must not block an otherwise valid rsync/SSH transfer.
    rsync $GET_REMOTE_DIR_OPTS "$REMOTE_USER@$1:$2" "$GET_TARGET_DIR/$1"
    GET_REMOTE_DIR_RC=$?

    echo "[INFO] Return code is $GET_REMOTE_DIR_RC"
    return $GET_REMOTE_DIR_RC
}

get_remote_dir() {
    GET_REMOTE_DIR_FAILED=0
    for GET_REMOTE_DIR_HOST in $GET_HOSTS; do
        for GET_REMOTE_DIR_SOURCE in $GET_REMOTE_DIRS; do
            get_remote "$GET_REMOTE_DIR_HOST" "$GET_REMOTE_DIR_SOURCE" || GET_REMOTE_DIR_FAILED=$?
        done
    done
    return $GET_REMOTE_DIR_FAILED
}

main() {
    start_message
    get_remote_dir
    return $?
}

main "$@"
