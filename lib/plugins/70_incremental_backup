#!/bin/sh
#
# 70_incremental_backup - A script to perform incremental backups with rsync.
#
# Required environment variables:
#   BACKUPTO    : Target backup directory.
#                 Example: /var/backups
#   BACKUPDIRS  : List of directories to back up (space-separated).
#                 Example: "/home /etc /var/www"
#   EXCLUDEFILE : File containing patterns of files/directories to exclude.
#                 Example: /etc/backup_exclude.conf
#   DRY_RUN     : If set to "true", rsync runs in dry-run mode.
#   EXPIREDAYS  : Number of days before old backups are purged. Required;
#                 the backup is skipped if it is unset or empty.
#
# Note:
#   - This script assumes that `rsync` is installed and available.
#   - An existing but unreadable EXCLUDEFILE skips the backup with a warning
#     rather than running rsync without the intended exclusions.
#
# Behavior:
#   - Local prerequisite failures return semantic status 3.
#   - Retention removal and rsync failures propagate the external command
#     status; rsync processing continues across configured backup sources.

DATE=${DATE:-$(date +%Y%m%d)}

start_message() {
    printf -- "[INFO] Loading: incremental_backup has been loaded at "
    date "+%Y/%m/%d %T"
}

purge_expire_dir() {
    while [ "$#" -gt 0 ]; do
        INCREMENTAL_BACKUP_ENTRY_DATE=${1##*_backup_}
        INCREMENTAL_BACKUP_EXPIRE_DATE=$(date -d "$EXPIREDAYS days ago" +%Y%m%d)

        if [ "$INCREMENTAL_BACKUP_ENTRY_DATE" -le "$INCREMENTAL_BACKUP_EXPIRE_DATE" ]; then
            printf -- "deleting %s/%s\n" "$BACKUPTO" "$1"
            rm -rf "$BACKUPTO/$1" || return $?
        fi
        shift
    done
    return 0
}

purge_expires() {
    printf -- "[INFO] Deleting old backup directories at "
    date "+%Y/%m/%d %T"

    for INCREMENTAL_BACKUP_DIR in "$BACKUPTO"/*_backup_*; do
        [ -e "$INCREMENTAL_BACKUP_DIR" ] || continue
        purge_expire_dir "$(basename "$INCREMENTAL_BACKUP_DIR")" || return $?
    done
    return 0
}

rsync_options() {
    INCREMENTAL_BACKUP_OPTS="--force --delete-excluded \
      --delete --backup \
      --backup-dir=$BACKUPTO/_backup_$DATE \
      -av"

    if [ -f "$EXCLUDEFILE" ]; then
        INCREMENTAL_BACKUP_OPTS="$INCREMENTAL_BACKUP_OPTS --exclude-from=/dev/stdin"
    fi
    [ "$DRY_RUN" = "true" ] && INCREMENTAL_BACKUP_OPTS="$INCREMENTAL_BACKUP_OPTS --dry-run"
    return 0
}

exec_rsync() {
    printf -- "[INFO] Executing: backup with rsync at "
    date "+%Y/%m/%d %T"

    if [ -f "$EXCLUDEFILE" ] && [ ! -r "$EXCLUDEFILE" ]; then
        printf -- "[WARN] Exclude file %s is not readable. Skipping backup.\n" \
            "$EXCLUDEFILE" >&2
        return 3
    fi

    INCREMENTAL_BACKUP_FAILED=0
    for INCREMENTAL_BACKUP_SOURCE in $BACKUPDIRS; do
        printf -- "[INFO] rsync %s %s %s\n" "$INCREMENTAL_BACKUP_OPTS" "$INCREMENTAL_BACKUP_SOURCE" "$BACKUPTO"
        if [ -f "$EXCLUDEFILE" ]; then
            # Strip blank lines and pipe the rest to --exclude-from=/dev/stdin, which skips # lines
            grep -v '^[# ]*$' "$EXCLUDEFILE" | rsync $INCREMENTAL_BACKUP_OPTS "$INCREMENTAL_BACKUP_SOURCE" "$BACKUPTO"
        else
            rsync $INCREMENTAL_BACKUP_OPTS "$INCREMENTAL_BACKUP_SOURCE" "$BACKUPTO"
        fi
        INCREMENTAL_BACKUP_RC=$?
        echo "[INFO] Return code is $INCREMENTAL_BACKUP_RC"
        [ "$INCREMENTAL_BACKUP_RC" -ne 0 ] && INCREMENTAL_BACKUP_FAILED=$INCREMENTAL_BACKUP_RC
    done
    return $INCREMENTAL_BACKUP_FAILED
}

run_rsync() {
    if [ ! -d "$BACKUPTO" ]; then
        printf -- "[WARN] Target directory %s does not exist. Skipping.\n" "$BACKUPTO" >&2
        return 3
    fi

    if [ -z "$EXPIREDAYS" ]; then
        printf -- "[WARN] EXPIREDAYS is not set. Skipping backup.\n" >&2
        return 3
    fi

    purge_expires || return $?
    rsync_options || return $?
    exec_rsync || return $?
}

main() {
    start_message
    run_rsync
    return $?
}

main "$@"
