#!/bin/sh
#
# 10_get_resources - A script to retrieve system resource information.
#
# Outputs:
#   - Kernel version (`uname -a`)
#   - Distribution information (`lsb_release -a` and/or `/etc/debian_version`)
#   - System uptime (`uptime`)
#   - Memory usage (`free -t`)
#   - Disk usage (`df -P -T`)
#   - Block device mapping (`lsblk`)
#   - Filesystem details (extended `lsblk -o`, with `lsblk -f` fallback)
#   - LVM logical volume mapping (`lvs -o lv_name,vg_name,lv_size,devices`)
#   - Network interface status (`ip addr show`)
#
# Note:
#   - This script assumes it is running on a POSIX-compliant system.
#   - `lsblk`, `lvs`, and `ip` must be installed to retrieve respective information.
#   - `lsb_release` is optional and used when available.
#   - A single-line value is logged as `[INFO] <name>: <value>`. Multi-line
#     output follows a short `[INFO] <name>:` heading in full.

start_message() {
    printf -- "[INFO] Loading: get_resources has been loaded at "
    date "+%Y/%m/%d %T"
}

log_value() {
    [ -n "$3" ] || return 0
    if [ "$2" -ne 0 ]; then
        printf '%s\n' "$3"
        return 0
    fi
    case $3 in
        *'
'*)
            echo "[INFO] $1:"
            printf '%s\n' "$3"
            ;;
        *)
            echo "[INFO] $1: $3"
            ;;
    esac
}

get_resources() {
    # Print kernel and system details
    (
        RESOURCE_OUT=$(uname -a)
        log_value "Kernel" $? "$RESOURCE_OUT"
    )

    # Prefer lsb_release output when available
    if command -v lsb_release >/dev/null 2>&1; then
        echo "[INFO] Distribution information:"
        lsb_release -a
    fi

    # Always log /etc/debian_version if it exists (for minor version etc.)
    if [ -f /etc/debian_version ]; then
        (
            RESOURCE_OUT=$(cat /etc/debian_version)
            log_value "Debian version" $? "$RESOURCE_OUT"
        )
    fi

    # Print system uptime and resource usage
    (
        RESOURCE_OUT=$(uptime)
        log_value "Uptime" $? "$RESOURCE_OUT"
    )

    echo "[INFO] Memory:"
    free -t

    echo "[INFO] Disk usage:"
    df -P -T

    # Retrieve block device and filesystem mapping
    if command -v lsblk > /dev/null 2>&1; then
        echo "[INFO] Block devices:"
        lsblk
        echo "[INFO] Filesystems:"
        if ! lsblk -o NAME,SIZE,TYPE,MODEL,SERIAL,FSTYPE,FSVER,UUID,FSAVAIL,FSUSE%,MOUNTPOINTS; then
            echo "[WARN] Extended lsblk output failed; falling back to lsblk -f" >&2
            lsblk -f
        fi
    else
        echo "[WARN] lsblk command not found" >&2
    fi

    # Retrieve LVM logical volume mapping (lv -> devices)
    if command -v lvs > /dev/null 2>&1; then
        echo "[INFO] LVM:"
        lvs -o lv_name,vg_name,lv_size,devices
    else
        echo "[WARN] lvs command not found" >&2
    fi

    # Retrieve network interface detailed status
    if command -v ip > /dev/null 2>&1; then
        echo "[INFO] Network interfaces:"
        ip addr show
    else
        echo "[WARN] ip command not found" >&2
    fi

    return 0
}

main() {
    start_message
    get_resources
    return $?
}

main "$@"
