#!/bin/sh
#
# 80_backup_to_remote - A script to sync local backups to remote servers using rsync.
#
# Required environment variables:
#   BACKUPTO     : Local backup directory.
#                  Example: /var/backups
#   BACKUPUSER   : Username for remote SSH login.
#                  Example: backupuser
#   REMOTE_HOSTS : List of remote servers (space-separated).
#                  Example: "server1.example.com server2.example.com"
#   REMOTE_DIR   : Target directory on remote servers.
#                  Example: /remote/backup
#   DRY_RUN      : If set to "true", rsync runs in dry-run mode.
#
# Note:
#   - This script assumes that SSH authentication is configured via SSH keys.
#   - No ping or other independent network/security probe gates the transfer;
#     rsync/SSH is attempted directly and its own status is returned.
#
# Behavior:
#   - A missing local backup directory returns semantic status 3.
#   - Each attempted rsync propagates its external status; remaining configured
#     remote hosts are still processed.

start_message() {
    printf -- "[INFO] Loading: backup_to_remote has been loaded at "
    date "+%Y/%m/%d %T"
}

mirror_to_remote() {
    BACKUP_TO_REMOTE_OPTS="-avz --delete -e ssh"

    [ "$DRY_RUN" = "true" ] && BACKUP_TO_REMOTE_OPTS="$BACKUP_TO_REMOTE_OPTS --dry-run"

    printf -- "[INFO] Executing: backup to remote at "
    date "+%Y/%m/%d %T"

    if [ -d "$BACKUPTO" ]; then
        printf -- "[INFO] rsync %s %s %s@%s:%s\n" "$BACKUP_TO_REMOTE_OPTS" "$BACKUPTO" "$BACKUPUSER" "$1" "$2"
        # Do not gate rsync on ping or other independent network/security probes.
        # Network policy must not block an otherwise valid rsync/SSH transfer.
        rsync $BACKUP_TO_REMOTE_OPTS "$BACKUPTO" "$BACKUPUSER@$1:$2"
        BACKUP_TO_REMOTE_RC=$?

        echo "[INFO] Return code is $BACKUP_TO_REMOTE_RC"
        return $BACKUP_TO_REMOTE_RC
    else
        printf -- "[WARN] Backup directory %s does not exist. Skipping.\n" "$BACKUPTO" >&2
        return 3
    fi
}

backup_to_remote() {
    BACKUP_TO_REMOTE_FAILED=0
    for BACKUP_TO_REMOTE_HOST in $REMOTE_HOSTS; do
        mirror_to_remote "$BACKUP_TO_REMOTE_HOST" "$REMOTE_DIR" || BACKUP_TO_REMOTE_FAILED=$?
    done
    return $BACKUP_TO_REMOTE_FAILED
}

main() {
    start_message
    backup_to_remote
    return $?
}

main "$@"
