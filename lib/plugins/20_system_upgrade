#!/bin/sh
#
# 20_system_upgrade - A script to upgrade the system packages based on the detected OS.
#
# Supported systems:
#   - Debian/Ubuntu (via apt-get)
#   - RedHat/CentOS (via yum)
#
# Required environment variables:
#   OLDKERNELS_COUNT : Number of old kernels to keep (for RHEL/CentOS).
#                      Example: 2
#
# Note:
#   - This script assumes that the system is connected to the internet and package managers are configured correctly.
#
# Behavior:
#   - Package-manager and freshclam operations can propagate external command
#     statuses instead of remapping every failure to semantic status 1.
#   - An active clamav-freshclam service is stopped only for the manual update
#     and is restarted afterward; an initially inactive service stays inactive.

start_message() {
    printf -- "[INFO] Loading: system_upgrade has been loaded at "
    date "+%Y/%m/%d %T"
}

# Return last command status from each updater
update_debian_or_ubuntu() {
    [ -f /etc/apt/sources.list ] && cat /etc/apt/sources.list

    printf -- "[INFO] Executing: apt upgrade at "
    date "+%Y/%m/%d %T"

    apt-get update && \
      apt-get -y upgrade && \
      apt-get autoclean && \
      apt-get -y autoremove

    SYSTEM_UPGRADE_RC=$?
    echo "[INFO] Return code is $SYSTEM_UPGRADE_RC"
    return $SYSTEM_UPGRADE_RC
}

update_redhat_or_centos() {
    # Use a dedicated name so the caller's SYSTEM_UPGRADE_FAILED is not overwritten
    SYSTEM_UPGRADE_YUM_FAILED=0
    [ -f /etc/yum.conf ] && cat /etc/yum.conf

    printf -- "[INFO] Executing: yum update at "
    date "+%Y/%m/%d %T"

    yum -y update && yum clean all
    SYSTEM_UPGRADE_RC=$?
    echo "[INFO] Return code is $SYSTEM_UPGRADE_RC"
    [ "$SYSTEM_UPGRADE_RC" -ne 0 ] && SYSTEM_UPGRADE_YUM_FAILED=$SYSTEM_UPGRADE_RC

    if command -v package-cleanup >/dev/null 2>&1; then
        if [ -n "${OLDKERNELS_COUNT:-}" ]; then
            package-cleanup -y --oldkernels --count "$OLDKERNELS_COUNT"
            SYSTEM_UPGRADE_RC=$?
            echo "[INFO] Return code is $SYSTEM_UPGRADE_RC"
            [ "$SYSTEM_UPGRADE_RC" -ne 0 ] && [ "$SYSTEM_UPGRADE_YUM_FAILED" -eq 0 ] && SYSTEM_UPGRADE_YUM_FAILED=$SYSTEM_UPGRADE_RC
        else
            echo "[WARN] OLDKERNELS_COUNT is not set skipping old kernel cleanup" >&2
        fi
    else
        echo "[WARN] package-cleanup command not found skipping old kernel cleanup" >&2
    fi

    return $SYSTEM_UPGRADE_YUM_FAILED
}

# Stop an active clamav-freshclam service for the manual update only, run
# freshclam, and restart the service afterward so its pre-update active or
# inactive state is preserved either way.
freshclam_manually() {
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "[WARN] systemctl not found skipping service stop start around freshclam" >&2

        printf -- "[INFO] Executing: freshclam at "
        date "+%Y/%m/%d %T"
        freshclam
        SYSTEM_UPGRADE_RC=$?
        echo "[INFO] Return code is $SYSTEM_UPGRADE_RC"
        return $SYSTEM_UPGRADE_RC
    fi

    systemctl is-active --quiet clamav-freshclam.service
    SYSTEM_UPGRADE_FRESHCLAM_ACTIVE=$?
    echo "[INFO] Return code is $SYSTEM_UPGRADE_FRESHCLAM_ACTIVE"

    if [ "$SYSTEM_UPGRADE_FRESHCLAM_ACTIVE" -ne 0 ]; then
        printf -- "[INFO] Executing: freshclam at "
        date "+%Y/%m/%d %T"
        freshclam
        SYSTEM_UPGRADE_RC=$?
        echo "[INFO] Return code is $SYSTEM_UPGRADE_RC"
        return $SYSTEM_UPGRADE_RC
    fi

    systemctl stop clamav-freshclam.service
    SYSTEM_UPGRADE_RC=$?
    echo "[INFO] Return code is $SYSTEM_UPGRADE_RC"
    if [ "$SYSTEM_UPGRADE_RC" -ne 0 ]; then
        return $SYSTEM_UPGRADE_RC
    fi

    printf -- "[INFO] Executing: freshclam at "
    date "+%Y/%m/%d %T"
    freshclam
    SYSTEM_UPGRADE_FRESHCLAM_RC=$?
    echo "[INFO] Return code is $SYSTEM_UPGRADE_FRESHCLAM_RC"

    systemctl start clamav-freshclam.service
    SYSTEM_UPGRADE_FRESHCLAM_START_RC=$?
    echo "[INFO] Return code is $SYSTEM_UPGRADE_FRESHCLAM_START_RC"

    if [ "$SYSTEM_UPGRADE_FRESHCLAM_RC" -ne 0 ]; then
        return $SYSTEM_UPGRADE_FRESHCLAM_RC
    fi
    return $SYSTEM_UPGRADE_FRESHCLAM_START_RC
}

system_upgrade() {
    SYSTEM_UPGRADE_FAILED=0
    if [ -f /etc/debian_version ]; then
        update_debian_or_ubuntu || SYSTEM_UPGRADE_FAILED=$?
    fi
    if [ -f /etc/redhat-release ]; then
        update_redhat_or_centos || SYSTEM_UPGRADE_FAILED=$?
    fi

    if command -v freshclam > /dev/null 2>&1; then
        freshclam_manually || SYSTEM_UPGRADE_FAILED=$?
    fi

    return $SYSTEM_UPGRADE_FAILED
}

main() {
    start_message
    system_upgrade
    return $?
}

main "$@"
