#!/bin/sh
#
# 09_show_version - A script to display installed versions of key software.
#
# Outputs:
#   - Ruby version
#   - RubyGems version
#   - Python version
#   - pip version
#   - Java version
#   - Go version
#   - Node.js version
#   - npm version
#   - Conda version
#   - Mamba version
#   - MongoDB version
#   - Protocol Buffers version
#   - MeCab version
#   - Aikido Safe Chain version
#
# Note:
#   - This script assumes the respective software is installed in `/opt/<software>/current/bin/`,
#     where `current` is managed manually. Java uses `/opt/java/jdk/current/bin/` and
#     MeCab uses `/opt/mecab-stack/bin/`.
#   - Aikido Safe Chain is never executed. Its version is the directory name that
#     the `/opt/safe-chain/current` symlink points to, read with `readlink`.
#   - A single-line version is logged as `[INFO] <name>: <version>`. Multi-line
#     output (Java, MongoDB) follows a short `[INFO] <name>:` header in full.

start_message() {
    printf -- "[INFO] Loading: show_version has been loaded at "
    date "+%Y/%m/%d %T"
}

log_version() {
    [ -n "$4" ] || return 0
    if [ "$3" -ne 0 ]; then
        printf '%s\n' "$4"
        return 0
    fi
    case $4 in
        *'
'*)
            echo "[INFO] $1:"
            printf '%s\n' "$4"
            return 0
            ;;
    esac
    if [ -n "$2" ]; then
        case $4 in
            "$2"?*)
                set -- "$1" "$2" "$3" "${4#"$2"}"
                echo "[INFO] $1: ${4%% *}"
                return 0
                ;;
        esac
    fi
    echo "[INFO] $1: $4"
}

log_native() {
    [ -n "$3" ] || return 0
    [ "$2" -eq 0 ] && echo "[INFO] $1:"
    printf '%s\n' "$3"
}

show_version() {
    [ -x /opt/ruby/current/bin/ruby ] && (
        VERSION_OUT=$(/opt/ruby/current/bin/ruby -v)
        log_version "Ruby" "ruby " $? "$VERSION_OUT"
    )

    [ -x /opt/ruby/current/bin/gem ] && (
        VERSION_OUT=$(PATH="/opt/ruby/current/bin:$PATH" /opt/ruby/current/bin/gem --version)
        log_version "RubyGems" "" $? "$VERSION_OUT"
    )

    [ -x /opt/python/current/bin/python ] && (
        VERSION_OUT=$(/opt/python/current/bin/python -V 2>&1)
        log_version "Python" "Python " $? "$VERSION_OUT"
    )

    [ -x /opt/python/current/bin/python ] && (
        VERSION_OUT=$(/opt/python/current/bin/python -m pip --version)
        log_version "pip" "pip " $? "$VERSION_OUT"
    )

    [ -x /opt/java/jdk/current/bin/java ] && (
        VERSION_OUT=$(/opt/java/jdk/current/bin/java -version 2>&1)
        log_native "Java" $? "$VERSION_OUT"
    )

    [ -x /opt/go/current/bin/go ] && (
        VERSION_OUT=$(/opt/go/current/bin/go version)
        log_version "Go" "go version go" $? "$VERSION_OUT"
    )

    [ -x /opt/node/current/bin/node ] && (
        VERSION_OUT=$(/opt/node/current/bin/node --version)
        log_version "Node.js" "v" $? "$VERSION_OUT"
    )

    [ -x /opt/node/current/bin/npm ] && (
        VERSION_OUT=$(PATH="/opt/node/current/bin:$PATH" /opt/node/current/bin/npm --version)
        log_version "npm" "" $? "$VERSION_OUT"
    )

    [ -x /opt/conda/current/bin/conda ] && (
        VERSION_OUT=$(/opt/conda/current/bin/conda --version)
        log_version "Conda" "conda " $? "$VERSION_OUT"
    )

    [ -x /opt/conda/current/bin/mamba ] && (
        VERSION_OUT=$(/opt/conda/current/bin/mamba --version)
        log_version "Mamba" "" $? "$VERSION_OUT"
    )

    [ -x /opt/mongo/current/bin/mongo ] && (
        VERSION_OUT=$(/opt/mongo/current/bin/mongo --version)
        log_native "MongoDB" $? "$VERSION_OUT"
    )

    [ -x /opt/protobuf/current/bin/protoc ] && (
        VERSION_OUT=$(/opt/protobuf/current/bin/protoc --version)
        log_version "Protocol Buffers" "libprotoc " $? "$VERSION_OUT"
    )

    [ -x /opt/mecab-stack/bin/mecab ] && (
        VERSION_OUT=$(/opt/mecab-stack/bin/mecab --version)
        log_version "MeCab" "mecab of " $? "$VERSION_OUT"
    )

    [ -x /opt/safe-chain/current/bin/safe-chain ] &&
    [ -L /opt/safe-chain/current ] &&
    command -v readlink >/dev/null 2>&1 && (
        SAFE_CHAIN_TARGET=$(readlink /opt/safe-chain/current 2>/dev/null) || exit 0
        SAFE_CHAIN_VERSION=${SAFE_CHAIN_TARGET##*/}
        if [ -n "$SAFE_CHAIN_VERSION" ]; then
            echo "[INFO] Aikido Safe Chain: $SAFE_CHAIN_VERSION"
        fi
    )

    return 0
}

main() {
    start_message
    show_version
    return $?
}

main "$@"
