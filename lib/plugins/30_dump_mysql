#!/bin/sh
#
# 30_dump_mysql - A script to dump MySQL databases and compress the dump.
#
# Required environment variables:
#   MYSQLDUMP  : Directory where the dump files (SQL and compressed files) will be stored.
#                Example: /var/lib/mysql/mysql_dump
#   MYSQL_USER : MySQL username.
#                Example: root
#   MYSQL_PASS : MySQL password.
#   MYSQL_DBS  : List of databases to back up (space-separated).
#                Example: "db1 db2 db3"
#
# Note:
#   - MYSQL_USER and MYSQL_PASS are passed to `mysqldump` on the command line,
#     so the password may be visible in the process list to other local users.
#     Use a MySQL option file (e.g. ~/.my.cnf) if that is a concern.
#
# Behavior:
#   - A missing dump directory returns semantic status 3.
#   - An executed dump/compression chain propagates its external command status;
#     processing continues with the remaining configured databases.

start_message() {
    printf -- "[INFO] Loading: dump_mysql has been loaded at "
    date "+%Y/%m/%d %T"
}

get_mysqldump() {
    printf -- "mysqldump %s\n" "$1"

    if [ ! -d "$MYSQLDUMP" ]; then
        printf -- "[WARN] Target directory %s does not exist. Skipping.\n" "$MYSQLDUMP" >&2
        return 3
    fi

    # Remove existing compressed dump if it exists
    [ -f "$MYSQLDUMP/$1.sql.gz" ] && rm "$MYSQLDUMP/$1.sql.gz"

    printf -- "[INFO] Executing: mysqldump at "
    date "+%Y/%m/%d %T"

    # Perform the dump and compress the output
    mysqldump --add-drop-table --add-locks --password="$3" -u "$2" \
      "$1" > "$MYSQLDUMP/$1.sql" \
      && gzip -f "$MYSQLDUMP/$1.sql"

    MYSQL_DUMP_RC=$?
    echo "[INFO] Return code is $MYSQL_DUMP_RC"
    return $MYSQL_DUMP_RC
}

dump_mysql() {
    MYSQL_DUMP_FAILED=0
    for MYSQL_DB in $MYSQL_DBS; do
        get_mysqldump "$MYSQL_DB" "$MYSQL_USER" "$MYSQL_PASS" || MYSQL_DUMP_FAILED=$?
    done
    return $MYSQL_DUMP_FAILED
}

main() {
    start_message
    dump_mysql
    return $?
}

main "$@"
