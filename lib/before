#!/bin/sh
#
# before - A script executed before the main deferred-sync process.
#
# This script is intended for pre-execution tasks, such as:
#   - Preparing temporary directories
#   - Checking system status before backup
#   - Logging the start of the sync process
#
# Note:
#   - This file is an example of the shape a STARTSCRIPT takes, not a place to keep one.
#     install.sh redeploys lib/ on every install, so an edit made here is lost on upgrade.
#     A host that needs its own pre-execution logic keeps that script outside the
#     installation target and points STARTSCRIPT in sync.conf at it.
#   - This script is sourced by the job, so it returns instead of exiting.

start_message() {
    printf -- "[INFO] Loading: startscript has been loaded at "
    date "+%Y/%m/%d %T"
}

main() {
    start_message
    # A host keeps its own pre-execution logic in the file STARTSCRIPT points at,
    # not here. See the note in the header.
    return $?
}

main "$@"
