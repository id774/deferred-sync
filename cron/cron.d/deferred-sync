# Scheduled execution of deferred-sync
# Runs Monday through Saturday at 03:01
# MAILTO delivers only stdout/stderr left over from the cron command to root.
# Normal deferred-sync output goes to JOBLOG, and mailing JOBLOG to an
# administrator is controlled by ADMIN_MAIL_ADDRESS in sync.conf.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=root

01 03 * * 1-6 root test -x /opt/deferred-sync/exec/deferred-sync && /opt/deferred-sync/exec/deferred-sync
