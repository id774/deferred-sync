# Scheduled execution of deferred-sync
# Runs Monday through Saturday at 03:01
# MAILTO receives only output left to cron; normal deferred-sync runtime output
# is written to JOBLOG, whose administrator mail is controlled by ADMIN_MAIL_ADDRESS.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=root

01 03 * * 1-6 root test -x /opt/deferred-sync/exec/deferred-sync && /opt/deferred-sync/exec/deferred-sync
